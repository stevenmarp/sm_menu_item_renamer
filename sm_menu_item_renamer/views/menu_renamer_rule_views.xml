<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_menu_renamer_rule_list" model="ir.ui.view">
        <field name="name">sm.menu.renamer.rule.list</field>
        <field name="model">sm.menu.renamer.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="menu_id" options="{'no_create': True}"/>
                <field name="new_name"/>
                <field name="lang" placeholder="All Languages"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sm_menu_renamer_rule_form" model="ir.ui.view">
        <field name="name">sm.menu.renamer.rule.form</field>
        <field name="model">sm.menu.renamer.rule</field>
        <field name="arch" type="xml">
            <form string="Menu Renamer Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="menu_id" options="{'no_create': True}"/>
                            <field name="new_name"/>
                        </group>
                        <group>
                            <field name="lang" placeholder="All Languages"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sm_menu_renamer_rule_search" model="ir.ui.view">
        <field name="name">sm.menu.renamer.rule.search</field>
        <field name="model">sm.menu.renamer.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="menu_id"/>
                <field name="new_name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sm_menu_renamer_rule" model="ir.actions.act_window">
        <field name="name">Menu Renamer Rules</field>
        <field name="res_model">sm.menu.renamer.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first menu rename rule
            </p>
            <p>
                Pick the menu item to rename and type the new name. Leave the
                language empty to apply the rename in every language.
            </p>
        </field>
    </record>

    <menuitem id="menu_sm_menu_renamer_root"
              name="Menu Renamer"
              parent="base.menu_administration"
              action="action_sm_menu_renamer_rule"
              groups="sm_menu_item_renamer.group_menu_renamer_manager"
              sequence="61"/>
</odoo>
